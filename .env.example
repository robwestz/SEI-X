# SIE-X Configuration
# Copy to .env and customize for your environment.
# All values shown are defaults — only override what you need.

# --- Environment ---
SIEX_ENV=development
SIEX_DEBUG=false

# --- Engine ---
SIEX_ENGINE__MODE=balanced
SIEX_ENGINE__EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
SIEX_ENGINE__SIMPLE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SIEX_ENGINE__SIMPLE_SPACY_MODEL=en_core_web_sm
SIEX_ENGINE__EMBEDDING_DIM=768
SIEX_ENGINE__BATCH_SIZE=32
SIEX_ENGINE__MAX_CHUNK_SIZE=512
SIEX_ENGINE__CACHE_SIZE=10000
SIEX_ENGINE__ENABLE_GPU=true
SIEX_ENGINE__ENABLE_MONITORING=true
SIEX_ENGINE__SIMILARITY_THRESHOLD=0.3
SIEX_ENGINE__MIN_CONFIDENCE=0.3
SIEX_ENGINE__PAGERANK_ALPHA=0.85
SIEX_ENGINE__DBSCAN_EPS=0.3
SIEX_ENGINE__DBSCAN_MIN_SAMPLES=2
SIEX_ENGINE__CHUNKING_THRESHOLD=5000
SIEX_ENGINE__OVERLAP_RATIO=0.1

# --- API ---
SIEX_API__HOST=0.0.0.0
SIEX_API__PORT=8000
# SIEX_API__CORS_ORIGINS=["https://yourdomain.com"]

# --- Auth ---
# IMPORTANT: Change this in production!
SIEX_AUTH__SECRET_KEY=dev_secret_key_change_in_production
SIEX_AUTH__ALGORITHM=HS256
SIEX_AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=30
SIEX_AUTH__TOKEN_EXPIRY_SECONDS=3600

# --- Cache ---
SIEX_CACHE__REDIS_URL=redis://localhost:6379
SIEX_CACHE__DEFAULT_TTL=3600
SIEX_CACHE__KEY_PREFIX=siex:
SIEX_CACHE__MAX_SIZE=10000

# --- Streaming (Kafka) ---
# SIEX_STREAMING__KAFKA_BROKERS=["localhost:9092"]
# SIEX_STREAMING__INPUT_TOPIC=siex-input
# SIEX_STREAMING__OUTPUT_TOPIC=siex-output
# SIEX_STREAMING__BATCH_SIZE=10

# --- Monitoring ---
SIEX_MONITORING__OTLP_ENDPOINT=localhost:4317
SIEX_MONITORING__OTLP_INSECURE=true
SIEX_MONITORING__LOG_LEVEL=INFO

# --- Rate Limiting ---
SIEX_RATE_LIMIT__DEFAULT_LIMIT=100/hour
SIEX_RATE_LIMIT__BURST_LIMIT=10/minute

# --- Resilience ---
SIEX_RESILIENCE__MAX_RETRIES=3
SIEX_RESILIENCE__MAX_BACKOFF_SECONDS=300
SIEX_RESILIENCE__MAX_MEMORY_MB=4096
SIEX_RESILIENCE__MAX_CONCURRENT=100

# --- Multilingual ---
SIEX_MULTILINGUAL__DEFAULT_LANGUAGE=en

# --- SDK Client ---
SIEX_SDK__BASE_URL=http://localhost:8000
SIEX_SDK__TIMEOUT=30.0
SIEX_SDK__MAX_RETRIES=3

# --- AutoML ---
SIEX_AUTOML__N_TRIALS=100
SIEX_AUTOML__OBJECTIVE_METRIC=f1_score
